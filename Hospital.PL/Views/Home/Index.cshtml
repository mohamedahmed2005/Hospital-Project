@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "NovaHealth";
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}
@if (TempData["Created"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Created');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}
<div class="toast-container position-fixed top-0 p-3">
    <div id="Created" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-primary">

            <strong class="me-auto text-white en-text">Saved</strong>
            <strong class="me-auto text-white ar-text">تم الحفظ</strong>

            <small class="en-text">1 mins ago</small>
            <small class="ar-text">قبل دقيقة واحدة</small>

            <button type="button" class="btn-close en-text" data-bs-dismiss="toast" aria-label="Close"></button>
            <button type="button" class="btn-close ar-text" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>

        <div class="toast-body text-success en-text">
            Patient Created successfully
        </div>
        <div class="toast-body text-success ar-text">
            تم إنشاء المريض بنجاح
        </div>
    </div>
</div>

@section PageStyles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-content">
                    <h1 class="hero-title">
                        <span class="en-text">Your Health is Our <span class="text-primary-color">Priority</span></span>
                        <span class="ar-text" style="display:none">صحتك هي <span class="text-primary-color">أولويتنا</span></span>
                    </h1>
                    <p class="lead mb-4">
                        <span class="en-text">
                            At NovaHealth, we provide world-class medical care with compassion and cutting-edge technology.
                            Our team of specialists is dedicated to your well-being and recovery.
                        </span>
                        <span class="ar-text" style="display:none">
                            في نوفا هيلث، نقدم رعاية طبية عالمية المستوى مع التعاطف والتكنولوجيا المتطورة. فريقنا من المتخصصين مكرس لرفاهيتك وتعافيك.
                        </span>
                    </p>
                    <div class="buttons my-4">
                        @if (isAuthenticated)
                        {
                            @if (!User.IsInRole("Doctor"))
                            {
                                <div class="top-buttons d-flex align-items-center">
                                    <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary-custom me-3" style="white-space: nowrap;">
                                        <span class="en-text">Book Appointment</span>
                                        <span class="ar-text" style="display:none">حجز موعد</span>
                                    </a>
                                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-custom" style="white-space: nowrap;">
                                        <span class="en-text">Emergency Care</span>
                                        <span class="ar-text" style="display:none">الرعاية الطارئة</span>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="top-buttons d-flex align-items-center">
                                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-custom" style="white-space: nowrap;">
                                        <span class="en-text">Emergency Care</span>
                                        <span class="ar-text" style="display:none">الرعاية الطارئة</span>
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="auth-buttons d-flex align-items-center">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Appointment")" class="btn btn-primary-custom me-3" style="white-space: nowrap;">
                                    <span class="en-text">Book Appointment</span>
                                    <span class="ar-text" style="display:none">حجز موعد</span>
                                </a>
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-custom me-3" style="white-space: nowrap;">
                                    <span class="en-text">Log In</span>
                                    <span class="ar-text" style="display:none">تسجيل الدخول</span>
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-custom" style="white-space: nowrap;">
                                    <span class="en-text">Sign Up</span>
                                    <span class="ar-text" style="display:none">إنشاء حساب</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image text-center">
                    <img src="~/images/HomePicture.avif" alt="Medical Professionals" class="img-fluid rounded-3" />
                </div>
            </div>
        </div>

        <div class="stats-bar">
          <div class="row text-center">
            <div class="col-md-3 col-6">
              <div class="stat">
                        <span class="counter" data-target="@ViewBag.DoctorCount">0</span>
                <h3>
                  <span class="en-text">Expert Doctors</span>
                  <span class="ar-text" style="display: none">أطباء خبراء</span>
                </h3>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="stat">
                        <span class="counter" data-target="@ViewBag.departmentCount">0</span>
                <h3>
                  <span class="en-text">Medical Departments</span>
                  <span class="ar-text" style="display: none">قسم طبي</span>
                </h3>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="stat">
                <span class="counter" data-target="15000">0</span>
                <h3>
                  <span class="en-text">Happy Patients</span>
                  <span class="ar-text" style="display: none">مريض سعيد</span>
                </h3>
              </div>
            </div>
            <div class="col-md-3 col-6">
              <div class="stat">
                <span>24/7</span>
                <h3>
                  <span class="en-text">Emergency Care</span>
                  <span class="ar-text" style="display: none">رعاية طارئة</span>
                </h3>
              </div>
            </div>
          </div>
        </div>
    </div>
</section>

<section class="emergency-section">
