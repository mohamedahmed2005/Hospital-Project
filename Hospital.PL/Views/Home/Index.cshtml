<section class="doctors-preview">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-4 fw-bold mb-3">
                    <span class="en-text">Meet Our <span class="text-primary-color">Specialists</span></span>
                    <span class="ar-text" style="display:none">تعرف على <span class="text-primary-color">متخصصينا</span></span>
                </h2>
                <p class="lead">
                    <span class="en-text">Our team of highly qualified doctors is dedicated to providing exceptional healthcare.</span>
                    <span class="ar-text" style="display:none">فريقنا من الأطباء المؤهلين تأهيلاً عالياً مكرس لتقديم رعاية صحية استثنائية.</span>
                </p>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var doctor in featuredDoctors)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="doctor-preview-card fade-in">
                        <img src="@doctor.Image" alt="@doctor.Name" class="doctor-avatar" />
                        <h4>@doctor.Name</h4>
                        <p class="text-primary-color">
                            <span class="en-text">@doctor.Specialty</span>
                            <span class="ar-text" style="display:none">@doctor.Specialty</span>
                        </p>
                        <p class="small">
                            <span class="en-text">@doctor.Experience</span>
                            <span class="ar-text" style="display:none">@doctor.Experience</span>
                        </p>
                        <a asp-controller="Doctor" asp-action="Index" class="btn btn-outline-custom btn-sm mt-2">
                            <span class="en-text">View Profile</span>
                            <span class="ar-text" style="display:none">عرض الملف</span>
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-5">
            <a asp-controller="Doctor" asp-action="Index" class="btn btn-primary-custom">
                <span class="en-text">View All Doctors</span>
                <span class="ar-text" style="display:none">عرض جميع الأطباء</span>
            </a>
        </div>
    </div>
</section>

<section class="news-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-4 fw-bold mb-3">
                    <span class="en-text">Latest <span class="text-primary-color">Health News</span></span>
                    <span class="ar-text" style="display:none">أحدث <span class="text-primary-color">أخبار الصحة</span></span>
                </h2>
                <p class="lead">
                    <span class="en-text">Stay informed with the latest medical advancements and health tips.</span>
                    <span class="ar-text" style="display:none">ابق على اطلاع بأحدث التطورات الطبية ونصائح الصحة.</span>
                </p>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var article in newsArticles)
            {
                <div class="col-md-4">
                    <div class="news-card fade-in">
                        <div class="news-image">
                            <img src="@article.Image" alt="@article.Title" />
                        </div>
                        <div class="news-content">
                            <span class="badge bg-primary mb-2">
                                <span class="en-text">@article.Category</span>
                                <span class="ar-text" style="display:none">@article.Category</span>
                            </span>
                            <h4>
                                <span class="en-text">@article.Title</span>
                                <span class="ar-text" style="display:none">@article.Title</span>
                            </h4>
                            <p>
                                <span class="en-text">@article.Description</span>
                                <span class="ar-text" style="display:none">@article.Description</span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="testimonials-carousel">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-4 fw-bold mb-3">
                    <span class="en-text">Patient <span class="text-primary-color">Testimonials</span></span>
                    <span class="ar-text" style="display:none">آراء <span class="text-primary-color">المرضى</span></span>
                </h2>
                <p class="lead">
                    <span class="en-text">Hear what our patients have to say about their experience at NovaHealth.</span>
                    <span class="ar-text" style="display:none">استمع إلى ما يقوله مرضانا عن تجربتهم في نوفا هيلث.</span>
                </p>
            </div>
        </div>
        <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @for (var i = 0; i < testimonials.Length; i++)
                {
                    var item = testimonials[i];
                    var activeClass = i == 0 ? "active" : string.Empty;
                    <div class="carousel-item @activeClass">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <div class="testimonial-card text-center">
                                    <div class="testimonial-text">
                                        <p>@item.Quote</p>
                                    </div>
                                    <div class="testimonial-author justify-content-center">
                                        <div class="author-image">
                                            <img src="@item.Avatar" alt="@item.Name" />
                                        </div>
                                        <div class="author-info">
                                            <h5 class="mb-0">@item.Name</h5>
                                            <p class="mb-0">
                                                <span class="en-text">@item.RoleEn</span>
                                                <span class="ar-text" style="display:none">@item.RoleAr</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">
                    <span class="en-text">Previous</span>
                    <span class="ar-text" style="display:none">السابق</span>
                </span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">
                    <span class="en-text">Next</span>
                    <span class="ar-text" style="display:none">التالي</span>
                </span>
            </button>
        </div>
    </div>
</section>


<section class="cta-section p-4 bg-primary-color text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h2 class="display-5 fw-bold mb-3">
                    <span class="en-text">Ready to take control of your health?</span>
                    <span class="ar-text" style="display:none">مستعد للاهتمام بصحتك؟</span>
                </h2>
                <p class="lead mb-4">
                    <span class="en-text">Schedule an appointment or contact us to learn more about our personalized care plans.</span>
                    <span class="ar-text" style="display:none">احجز موعدًا أو تواصل معنا لمعرفة المزيد عن خطط الرعاية الشخصية.</span>
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Appointment" asp-action="Create" class="btn btn-light btn-lg px-4 py-2 fw-bold">
                    <span class="en-text">Schedule Now</span>
                    <span class="ar-text" style="display:none">احجز الآن</span>
                </a>
                @if (isAuthenticated)
                {
                    <a asp-controller="Patient" asp-action="Index" class="btn btn-light btn-lg px-4 py-2 fw-bold">
                        <span class="en-text">Patient Portal</span>
                        <span class="ar-text" style="display:none">بوابة المرضى</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-custom">
                        <span class="en-text">Patient Portal</span>
                        <span class="ar-text" style="display:none">بوابة المرضى</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
