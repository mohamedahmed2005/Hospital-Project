@model Hospital.DAL.Models.MedicalRecordModule.MedicalRecord
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit Medical Record";
    var patients = ViewBag.Patients as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/patients.css" asp-append-version="true" />
}

<section class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-3">
                    <span class="en-text">Edit Medical Record</span>
                    <span class="ar-text" style="display:none">تعديل السجل الطبي</span>
                </h1>
                <p class="lead mb-0">
                    <span class="en-text">Update diagnosis, treatment, and prescription information.</span>
                    <span class="ar-text" style="display:none">قم بتحديث معلومات التشخيص والعلاج والوصفة.</span>
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="Index" class="btn btn-outline-custom">
                    <i class="bi bi-arrow-left me-2"></i>
                    <span class="en-text">Back to Records</span>
                    <span class="ar-text" style="display:none">العودة للسجلات</span>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="DoctorId" />
                    <input type="hidden" asp-for="RecordDate" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PatientId" class="form-label">
                                <span class="en-text">Patient</span>
                                <span class="ar-text" style="display:none">المريض</span>
                            </label>
                            <select asp-for="PatientId" class="form-select" required>
                                <option value="">Select Patient</option>
                                @foreach (var patient in patients)
                                {
                                    if (Model.PatientId == patient.Id)
                                    {
                                        <option value="@patient.Id" selected>@patient.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@patient.Id">@patient.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PatientId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">
                                <span class="en-text">Record Date</span>
                                <span class="ar-text" style="display:none">تاريخ السجل</span>
                            </label>
                            <input type="text" class="form-control" value="@Model.RecordDate.ToString("MMMM dd, yyyy h:mm tt")" disabled />
                            <small class="form-text text-muted">
                                <span class="en-text">Record date cannot be changed</span>
                                <span class="ar-text" style="display:none">لا يمكن تغيير تاريخ السجل</span>
                            </small>
                        </div>
                        <div class="col-12">
                            <label asp-for="Diagnosis" class="form-label">
                                <span class="en-text">Diagnosis</span>
                                <span class="ar-text" style="display:none">التشخيص</span>
                            </label>
                            <textarea asp-for="Diagnosis" rows="3" class="form-control" placeholder="Enter diagnosis details..." required></textarea>
                            <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Treatment" class="form-label">
                                <span class="en-text">Treatment</span>
                                <span class="ar-text" style="display:none">العلاج</span>
                            </label>
                            <textarea asp-for="Treatment" rows="4" class="form-control" placeholder="Enter treatment plan and procedures..." required></textarea>
                            <span asp-validation-for="Treatment" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Prescription" class="form-label">
                                <span class="en-text">Prescription</span>
                                <span class="ar-text" style="display:none">الوصفة</span>
                            </label>
                            <textarea asp-for="Prescription" rows="4" class="form-control" placeholder="Enter prescribed medications and dosages..." required></textarea>
                            <span asp-validation-for="Prescription" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">
                                <span class="en-text">Additional Notes</span>
                                <span class="ar-text" style="display:none">ملاحظات إضافية</span>
                            </label>
                            <textarea asp-for="Notes" rows="3" class="form-control" placeholder="Any additional notes or observations..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-custom">
                            <span class="en-text">Cancel</span>
                            <span class="ar-text" style="display:none">إلغاء</span>
                        </a>
                        <button type="submit" class="btn btn-primary-custom">
                            <span class="en-text">Update Record</span>
                            <span class="ar-text" style="display:none">تحديث السجل</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

