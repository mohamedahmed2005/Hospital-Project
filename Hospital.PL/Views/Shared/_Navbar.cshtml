                                    <span class="en-text">Add Department</span>
                                    <span class="ar-text" style="display:none">إضافة قسم</span>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                    <span class="en-text">Change Password</span>
                                    <span class="ar-text" style="display:none">تغيير كلمة المرور</span>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                    <span class="en-text">Logout</span>
                                    <span class="ar-text" style="display:none">تسجيل خروج</span>
                                </a></li>
                            </ul>
                        </div>
                    }
                    @* Doctor Actions *@
                    else if (User.IsInRole("Doctor"))
                    {
                        <a href="@Url.Action("MyAppointments", "DoctorAppointment")" class="btn btn-primary-custom btn-sm">
                            <span class="en-text">My Appointments</span>
                            <span class="ar-text" style="display:none">مواعيدي</span>
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-outline-custom btn-sm dropdown-toggle" type="button" id="doctorDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="en-text">Profile</span>
                                <span class="ar-text" style="display:none">الملف</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="doctorDropdown">
                                <li class="dropdown-header">
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="fw-bold">@(!string.IsNullOrEmpty(userName) ? userName : userEmail)</div>
                                            <small class="text-muted">@userEmail</small>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("MyProfile", "Doctor")">
                                    <span class="en-text">My Profile</span>
                                    <span class="ar-text" style="display:none">ملفي الشخصي</span>
                                </a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Doctor", "Dashboard")">
                                    <span class="en-text">Dashboard</span>
                                    <span class="ar-text" style="display:none">لوحة التحكم</span>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                    <span class="en-text">Change Password</span>
                                    <span class="ar-text" style="display:none">تغيير كلمة المرور</span>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                    <span class="en-text">Logout</span>
                                    <span class="ar-text" style="display:none">تسجيل خروج</span>
                                </a></li>
                            </ul>
                        </div>
                    }
                    @* Patient Actions *@
                    else if (User.IsInRole("Patient"))
                    {
                        <a href="@Url.Action("Create", "Appointment")" class="btn btn-primary-custom btn-sm">
                            <span class="en-text">Book Appointment</span>
                            <span class="ar-text" style="display:none">حجز موعد</span>
                        </a>
                        <div class="dropdown">
                            <button class="btn btn-outline-custom btn-sm dropdown-toggle" type="button" id="patientDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="en-text">Account</span>
                                <span class="ar-text" style="display:none">الحساب</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="patientDropdown">
                                <li class="dropdown-header">
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="fw-bold">@(!string.IsNullOrEmpty(userName) ? userName : userEmail)</div>
                                            <small class="text-muted">@userEmail</small>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Patient", "Dashboard")">
                                    <span class="en-text">Dashboard</span>
                                    <span class="ar-text" style="display:none">لوحة التحكم</span>
                                </a></li>
                                <li><a class="dropdown-item" href="@Url.Action("MyProfile", "Patient")">
                                    <span class="en-text">My Profile</span>
                                    <span class="ar-text" style="display:none">ملفي الشخصي</span>
                                </a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Appointment")">
                                    <span class="en-text">My Appointments</span>
                                    <span class="ar-text" style="display:none">مواعيدي</span>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                    <span class="en-text">Change Password</span>
                                    <span class="ar-text" style="display:none">تغيير كلمة المرور</span>
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                    <span class="en-text">Logout</span>
                                    <span class="ar-text" style="display:none">تسجيل خروج</span>
                                </a></li>
                            </ul>
                        </div>
                    }
                }
                else
                {
                    @if (isHomePage)
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-custom btn-sm px-4">
                            <span class="en-text">Log In</span>
                            <span class="ar-text" style="display:none">تسجيل الدخول</span>
                        </a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-primary-custom btn-sm px-4">
                            <span class="en-text">Sign Up</span>
                            <span class="ar-text" style="display:none">إنشاء حساب</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-custom btn-sm">
                            <span class="en-text">Log In</span>
                            <span class="ar-text" style="display:none">تسجيل الدخول</span>
                        </a>
                        <a href="@Url.Action("Register", "Account")" class="btn btn-primary-custom btn-sm">
                            <span class="en-text">Sign Up</span>
                            <span class="ar-text" style="display:none">إنشاء حساب</span>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</nav>

