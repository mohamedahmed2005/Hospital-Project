@inject Microsoft.AspNetCore.Identity.UserManager<Hospital.DAL.Models.Shared.ApplicationUser> UserManager
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool isHomePage = currentController?.Equals("Home", StringComparison.OrdinalIgnoreCase) == true && 
                      currentAction?.Equals("Index", StringComparison.OrdinalIgnoreCase) == true;
    
    string userName = "";
    string userEmail = "";
    if (isAuthenticated)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            userName = user.UserName ?? "";
            userEmail = user.Email ?? "";
        }
    }

    // Add a CSS helper class based on role (used to tweak navbar styling per role)
    string navRoleClass = "";
    if (isAuthenticated && User.IsInRole("Doctor"))
    {
        navRoleClass = " navbar-doctor";
    }
    else if (isAuthenticated && User.IsInRole("Admin"))
    {
        navRoleClass = " navbar-admin";
    }
    else if (isAuthenticated && User.IsInRole("Patient"))
    {
        navRoleClass = " navbar-patient";
    }

    string GetActiveClass(string controller, string action = null)
    {
        if (currentController == controller)
        {
            if (action == null || currentAction == action)
                return "active";
        }
        return "";
    }
}
<nav class="navbar navbar-expand-lg navbar-light sticky-top@navRoleClass">
    <div class="container">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            <i class="bi bi-heart-pulse me-2"></i>
            <span class="en-text">NovaHealth</span>
            <span class="ar-text" style="display: none">نوفا هيلث</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav m-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @GetActiveClass("Home", "Index")" href="@Url.Action("Index", "Home")">
                        <span class="en-text">Home</span>
                        <span class="ar-text" style="display:none">الرئيسية</span>
                    </a>
                </li>

                @* Admin Navigation *@
                @if (isAuthenticated && User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Dashboard")" href="@Url.Action("Admin", "Dashboard")">
                            <span class="en-text">Dashboard</span>
                            <span class="ar-text" style="display:none">لوحة التحكم</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Patient")" href="@Url.Action("Index", "Patient")">
                            <span class="en-text">Patients</span>
                            <span class="ar-text" style="display:none">المرضى</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Appointment")" href="@Url.Action("Index", "Appointment")">
                            <span class="en-text">Appointments</span>
                            <span class="ar-text" style="display:none">المواعيد</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Doctor")" href="@Url.Action("Index", "Doctor")">
                            <span class="en-text">Doctors</span>
                            <span class="ar-text" style="display:none">الأطباء</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Department")" href="@Url.Action("Index", "Department")">
                            <span class="en-text">Departments</span>
                            <span class="ar-text" style="display:none">الأقسام</span>
                        </a>
                    </li>
                }
                @* Doctor Navigation *@
                else if (isAuthenticated && User.IsInRole("Doctor"))
                {
                 
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("DoctorAppointment")" href="@Url.Action("MyAppointments", "DoctorAppointment")">
                            <span class="en-text">My Appointments</span>
                            <span class="ar-text" style="display:none">مواعيدي</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("MedicalRecord")" href="@Url.Action("Index", "MedicalRecord")">
                            <span class="en-text">Medical Records</span>
                            <span class="ar-text" style="display:none">السجلات الطبية</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Patient")" href="@Url.Action("Index", "Patient")">
                            <span class="en-text">Patients</span>
                            <span class="ar-text" style="display:none">المرضى</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Department")" href="@Url.Action("Index", "Department")">
                            <span class="en-text">Departments</span>
                            <span class="ar-text" style="display:none">الأقسام</span>
                        </a>
                    </li>
                }
                @* Unauthenticated/Guest Navigation *@
                else
                {
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Appointment")" href="@Url.Action("Index", "Appointment")">
                            <span class="en-text">Appointments</span>
                            <span class="ar-text" style="display:none">المواعيد</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Doctor")" href="@Url.Action("Index", "Doctor")">
                            <span class="en-text">Doctors</span>
                            <span class="ar-text" style="display:none">الأطباء</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @GetActiveClass("Department")" href="@Url.Action("Index", "Department")">
                            <span class="en-text">Departments</span>
                            <span class="ar-text" style="display:none">الأقسام</span>
                        </a>
                    </li>
                }

                @* Common Navigation Items *@
                <li class="nav-item">
                    <a class="nav-link @GetActiveClass("Home", "About")" href="@Url.Action("About", "Home")">
                        <span class="en-text">About Us</span>
                        <span class="ar-text" style="display:none">من نحن</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @GetActiveClass("Home", "Contact")" href="@Url.Action("Contact", "Home")">
                        <span class="en-text">Contact</span>
                        <span class="ar-text" style="display:none">اتصل بنا</span>
                    </a>
                </li>
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (isAuthenticated)
                {
                    @* Admin Actions *@
                    @if (User.IsInRole("Admin"))
