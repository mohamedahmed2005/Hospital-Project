                                            <small class="text-muted">@userEmail</small>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Create", "Doctor")">
                                    <span class="en-text">Add Doctor</span>
                                    <span class="ar-text" style="display:none">إضافة طبيب</span>
                                </a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Create", "Patient")">
                                    <span class="en-text">Add Patient</span>
                                    <span class="ar-text" style="display:none">إضافة مريض</span>
                                </a></li>
