                        </a>
                        <div class="dropdown">
                            <button class="btn btn-outline-custom btn-sm dropdown-toggle" type="button" id="adminDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="en-text">Manage</span>
                                <span class="ar-text" style="display:none">إدارة</span>
                            </button>
