@*
    Modern public layout that mirrors the static NovaHealth pages.
    Pages using this layout must define optional sections:
    - PageStyles: per-page stylesheets
    - Scripts: per-page scripts
*@
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - NovaHealth</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700;800&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="shortcut icon" href="~/images/icon.png" type="image/x-icon" />

    <link rel="stylesheet" href="~/Bootstrap/CSS/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    @RenderSection("PageStyles", required: false)
</head>
<body>
    <div class="dark-mode-toggle" id="darkModeToggle">
        <i class="bi bi-moon"></i>
    </div>

    <div class="language-switcher" id="languageSwitcher">ع</div>
    <div class="alert-message" id="alertMessage"></div>

    <partial name="_Navbar" />


    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5>
                        <i class="bi bi-heart-pulse me-2"></i>
                        <span class="en-text">NovaHealth</span>
                        <span class="ar-text" style="display:none">نوفا هيلث</span>
                    </h5>
                    <p class="mt-3">
                        <span class="en-text">Providing exceptional healthcare with compassion, innovation, and excellence since 2005.</span>
                        <span class="ar-text" style="display:none">تقديم رعاية صحية استثنائية مع التعاطف والابتكار والتميز منذ عام 2005.</span>
                    </p>
                    <div class="social-links mt-4">
                        <a href="#" class="me-3"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="me-3"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="me-3"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="me-3"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-lg-2">
                    <h5>
                        <span class="en-text">Quick Links</span>
                        <span class="ar-text" style="display:none">روابط سريعة</span>
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-controller="Patient" asp-action="Index">Patients</a></li>
                        <li class="mb-2"><a asp-controller="Appointment" asp-action="Index">Appointments</a></li>
                        <li class="mb-2"><a asp-controller="Doctor" asp-action="Index">Doctors</a></li>
                        <li class="mb-2"><a asp-controller="Department" asp-action="Index">Departments</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h5>
                        <span class="en-text">Our Services</span>
                        <span class="ar-text" style="display:none">خدماتنا</span>
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#">Cardiology</a></li>
                        <li class="mb-2"><a href="#">Neurology</a></li>
                        <li class="mb-2"><a href="#">Orthopedics</a></li>
                        <li class="mb-2"><a href="#">Pediatrics</a></li>
                        <li class="mb-2"><a href="#">Emergency Care</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h5>
                        <span class="en-text">Contact Us</span>
                        <span class="ar-text" style="display:none">اتصل بنا</span>
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="bi bi-geo-alt me-2"></i>
                            <span class="en-text">123 Medical Drive, Health City</span>
                            <span class="ar-text" style="display:none">123 شارع طبي، مدينة الصحة</span>
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-telephone me-2"></i> (555) 123-4567
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope me-2"></i> info@novahealth.com
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-clock me-2"></i>
                            <span class="en-text">24/7 Emergency Services</span>
                            <span class="ar-text" style="display:none">خدمات الطوارئ 24/7</span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom text-center">
                <p class="mb-0">
                    <span class="en-text">&copy; 2025 NovaHealth. All rights reserved.</span>
                    <span class="ar-text" style="display:none">© 2025 نوفا هيلث. جميع الحقوق محفوظة.</span>
                </p>
            </div>
        </div>
    </footer>

    <script src="~/Bootstrap/JS/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/index.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

