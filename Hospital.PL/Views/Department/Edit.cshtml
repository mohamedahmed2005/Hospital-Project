@model Hospital.PL.ViewModels.DepartmentViewModel
@using Hospital.DAL.Models.DepartmentModule
@{
    ViewData["Title"] = "Edit Department";
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/departments.css" asp-append-version="true" />
}

<section class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-3">
                    <span class="en-text">Edit Department</span>
                    <span class="ar-text" style="display:none">تعديل القسم</span>
                </h1>
                <p class="lead mb-0">
                    <span class="en-text">Update specialty, status, location, and leadership assignments.</span>
                    <span class="ar-text" style="display:none">قم بتحديث التخصص والحالة والموقع وتعيينات القيادة.</span>
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="Index" class="btn btn-outline-custom">
                    <i class="bi bi-arrow-left me-2"></i>
                    <span class="en-text">Back to Departments</span>
                    <span class="ar-text" style="display:none">العودة للأقسام</span>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">
                                <span class="en-text">Department Name</span>
                                <span class="ar-text" style="display:none">اسم القسم</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentSpeciality" class="form-label">
                                <span class="en-text">Specialty</span>
                                <span class="ar-text" style="display:none">التخصص</span>
                            </label>
                            <input asp-for="DepartmentSpeciality" class="form-control" />
                            <span asp-validation-for="DepartmentSpeciality" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label">
                                <span class="en-text">Status</span>
                                <span class="ar-text" style="display:none">الحالة</span>
                            </label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var status in Enum.GetValues<DepartmentStatus>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DoctorId" class="form-label">
                                <span class="en-text">Department Head</span>
                                <span class="ar-text" style="display:none">رئيس القسم</span>
                            </label>
                            <select asp-for="DoctorId" class="form-select" asp-items="Model.Doctors">
                                <option value="">Select Doctor</option>
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label">
                                <span class="en-text">Location</span>
                                <span class="ar-text" style="display:none">الموقع</span>
                            </label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="KeyServices" class="form-label">
                                <span class="en-text">Key Services</span>
                                <span class="ar-text" style="display:none">الخدمات الرئيسية</span>
                            </label>
                            <input asp-for="KeyServices" class="form-control" />
                            <span asp-validation-for="KeyServices" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                <span class="en-text">Description</span>
                                <span class="ar-text" style="display:none">الوصف</span>
                            </label>
                            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-custom">
                            <span class="en-text">Cancel</span>
                            <span class="ar-text" style="display:none">إلغاء</span>
                        </a>
                        <button type="submit" class="btn btn-primary-custom">
                            <span class="en-text">Update Department</span>
                            <span class="ar-text" style="display:none">تحديث القسم</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

