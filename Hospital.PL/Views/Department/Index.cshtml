@using Hospital.BBL.DTOs.DepartmentDTOs
@using Hospital.DAL.Models.DepartmentModule
@model IEnumerable<GetAllDepartmentsDto>

@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Departments";
    var departments = Model?.ToList() ?? new List<GetAllDepartmentsDto>();
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var totalDepartments = departments.Count();
    var activeDepartments = departments.Count(d => d.Status == DepartmentStatus.Active);
    var inactiveDepartments = departments.Count(d => d.Status == DepartmentStatus.InActive);
    var maintenanceDepartments = departments.Count(d => d.Status == DepartmentStatus.Maintenance);
    var staffEstimate = Math.Max(40, departments.Count * 8);
    var monthlyPatients = Math.Max(1200, departments.Count * 200);

    string StatusBadgeClass(DepartmentStatus status) => status switch
    {
        DepartmentStatus.Active => "badge badge-active",
        DepartmentStatus.InActive => "badge badge-inactive",
        DepartmentStatus.Maintenance => "badge badge-maintenance",
        _ => "badge badge-default"
    };
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/departments.css" asp-append-version="true" />
}
@if (TempData["Edited"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Edited');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}

@if (TempData["Created"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Created');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}

@if (TempData["Deleted"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Deleted');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="Created" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
        <div class="toast-header border-0" style="background: rgba(255, 255, 255, 0.1);">
            <i class="bi bi-check-circle-fill text-white me-2"></i>
            <strong class="me-auto text-white en-text">Success</strong>
            <strong class="me-auto text-white ar-text" style="display:none">نجاح</strong>
            <small class="text-white-50">just now</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-white">
            <div class="en-text">Department created successfully</div>
            <div class="ar-text" style="display:none">تم إنشاء القسم بنجاح</div>
        </div>
    </div>

    <div id="Edited" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #198754 0%, #157347 100%);">
        <div class="toast-header border-0" style="background: rgba(255, 255, 255, 0.1);">
            <i class="bi bi-pencil-square text-white me-2"></i>
            <strong class="me-auto text-white en-text">Updated</strong>
            <strong class="me-auto text-white ar-text" style="display:none">تم التحديث</strong>
            <small class="text-white-50">just now</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-white">
            <div class="en-text">Department updated successfully</div>
            <div class="ar-text" style="display:none">تم تحديث القسم بنجاح</div>
        </div>
    </div>

    <div id="Deleted" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);">
        <div class="toast-header border-0" style="background: rgba(255, 255, 255, 0.1);">
            <i class="bi bi-trash-fill text-white me-2"></i>
            <strong class="me-auto text-white en-text">Deleted</strong>
            <strong class="me-auto text-white ar-text" style="display:none">تم الحذف</strong>
            <small class="text-white-50">just now</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-white">
            <div class="en-text">Department deleted successfully</div>
            <div class="ar-text" style="display:none">تم حذف القسم بنجاح</div>
        </div>
    </div>
</div>


<section class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-3">
                    <span class="en-text">Hospital Departments</span>
                    <span class="ar-text" style="display:none">أقسام المستشفى</span>
                </h1>
                <p class="lead mb-0">
                    <span class="en-text">Monitor department performance, capacity, and staffing in one dashboard.</span>
                    <span class="ar-text" style="display:none">راقب أداء الأقسام والطاقة الاستيعابية والموظفين في لوحة واحدة.</span>
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                @if (isAuthenticated && (ViewBag.CanModify == true || User.IsInRole("Admin")))
                {
                    <a asp-action="Create" class="btn btn-primary-custom">
                        <i class="bi bi-plus-circle me-2"></i>
                        <span class="en-text">Add Department</span>
                        <span class="ar-text" style="display:none">إضافة قسم</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="stats-section mt-3">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <span class="label en-text">Total Departments</span>
                    <span class="label ar-text" style="display:none">إجمالي الأقسام</span>
                    <h3 id="@totalDepartments">@totalDepartments</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <span class="label en-text">Medical Staff</span>
                    <span class="label ar-text" style="display:none">الطاقم الطبي</span>
                    <h3 id="medicalStaff">@staffEstimate</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <span class="label en-text">Active Departments</span>
                    <span class="label ar-text" style="display:none">الأقسام النشطة</span>
                    <h3 id="@activeDepartments">@activeDepartments</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <span class="label en-text">Monthly Patients</span>
                    <span class="label ar-text" style="display:none">المرضى شهرياً</span>
                    <h3 id="monthlyPatients">@monthlyPatients</h3>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="row g-3 mb-4">
            <div class="col-lg-5">
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           id="departmentSearchInput"
                           placeholder="Search departments by name, specialty, or location..."
                           data-ar-placeholder="ابحث عن الأقسام بالاسم أو التخصص أو الموقع..." />
                </div>
            </div>
            <div class="col-lg-3">
                <select class="form-select" id="departmentStatusFilter">
                    <option value="" data-en="All Statuses" data-ar="جميع الحالات">All Statuses</option>
                    @foreach (var status in Enum.GetValues<DepartmentStatus>())
                    {
                        <option value="@status.ToString().ToLowerInvariant()" data-en="@status" data-ar="@status">@status</option>
                    }
                </select>
            </div>
            <div class="col-lg-4">
                <div class="view-toggle d-flex">
                    <button class="view-toggle-btn active" id="tableViewBtn">
                        <i class="bi bi-list-ul me-2"></i>
                        <span class="en-text">Table View</span>
                        <span class="ar-text" style="display:none">عرض الجدول</span>
                    </button>
                    <button class="view-toggle-btn" id="gridViewBtn">
                        <i class="bi bi-grid me-2"></i>
                        <span class="en-text">Grid View</span>
                        <span class="ar-text" style="display:none">عرض الشبكة</span>
                    </button>
                </div>
            </div>
        </div>

        <div id="tableView">
            <div class="table-responsive">
                <table class="table table-custom table-hover">
                    <thead>
                        <tr>
                            <th><span class="en-text">Department</span><span class="ar-text" style="display:none">القسم</span></th>
                            <th><span class="en-text">Specialty</span><span class="ar-text" style="display:none">التخصص</span></th>
                            <th><span class="en-text">Location</span><span class="ar-text" style="display:none">الموقع</span></th>
                            <th><span class="en-text">Status</span><span class="ar-text" style="display:none">الحالة</span></th>
                            <th><span class="en-text">Actions</span><span class="ar-text" style="display:none">الإجراءات</span></th>
                        </tr>
                    </thead>
                    <tbody id="departmentsTableBody">
                        @if (departments.Any())
                        {
                            foreach (var department in departments)
                            {
                                var statusClass = StatusBadgeClass(department.Status);
                                var searchKey = $"{department.Name} {department.DepartmentSpeciality} {department.Location}".ToLowerInvariant();
                                <tr data-status="@department.Status.ToString().ToLowerInvariant()" data-keyword="@searchKey">
                                    <td>
                                        <strong>@department.Name</strong>
                                        <div class="text-muted small">@department.Location</div>
                                    </td>
                                    <td>@department.DepartmentSpeciality</td>
                                    <td>@department.Location</td>
                                    <td>
                                        <span class="@statusClass">
                                            <span class="en-text">@department.Status</span>
                                            <span class="ar-text" style="display:none">@department.Status</span>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-sm btn-outline-custom btn-sm-custom">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (isAuthenticated && (ViewBag.CanModify == true || User.IsInRole("Admin")))
                                            {
                                                <a asp-action="Edit" asp-route-id="@department.Id" class="btn btn-sm btn-outline-custom btn-sm-custom">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-custom btn-sm-custom" data-bs-toggle="modal" data-bs-target="#Department_delete">

                                                    <i class="bi bi-trash"></i>
                                                </button>
                                                <div class="modal fade" id="Department_delete" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden"
                                                             style="background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%); border: 1px solid rgba(13, 110, 253, 0.1);">

                                                            <div class="modal-header border-0 pb-0"
                                                                 style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                                                                <div class="modal-title w-100 text-center">
                                                                    <i class="bi bi-exclamation-triangle-fill text-white fs-2 mb-2 d-block"></i>
                                                                    <h5 class="text-white en-text mb-0 fw-bold">Confirm Deletion</h5>
                                                                    <h5 class="text-white ar-text mb-0 fw-bold" style="display:none">تأكيد الحذف</h5>
                                                                </div>
                                                                <button type="button" class="btn-close btn-close-white position-absolute end-0 me-3"
                                                                        data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>

                                                            <div class="modal-body pt-4 pb-3 text-center">
                                                                <p class="text-black en-text fs-5 mb-2">
                                                                    Are you sure you want to delete this department?
                                                                </p>
                                                                <p class="text-black ar-text fs-5 mb-2" style="display:none">
                                                                    هل أنت متأكد من رغبتك في حذف هذا القسم؟
                                                                </p>
                                                                <p class="  en-text small mb-0">
                                                                    This action cannot be undone.
                                                                </p>
                                                                <p class="  ar-text small mb-0" style="display:none">
                                                                    لا يمكن التراجع عن هذا الإجراء.
                                                                </p>
                                                            </div>

                                                            <div class="modal-footer border-0 pt-0">
                                                                <form method="post" asp-action="Delete"
                                                                      asp-route-id="@department.Id" class="w-100">
                                                                    @Html.AntiForgeryToken()
                                                                    <div class="row g-2">
                                                                        <div class="col-6">
                                                                            <button type="button"
                                                                                    class="btn btn-lg w-100 border-0 rounded-3 en-text"
                                                                                    style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); color: white;"
                                                                                    data-bs-dismiss="modal">
                                                                                Cancel
                                                                            </button>
                                                                            <button type="button"
                                                                                    class="btn btn-lg w-100 border-0 rounded-3 ar-text"
                                                                                    style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); color: white; display:none"
                                                                                    data-bs-dismiss="modal">
                                                                                إلغاء
                                                                            </button>
                                                                        </div>
                                                                        <div class="col-6">
                                                                            <button type="submit"
                                                                                    class="btn btn-lg w-100 border-0 rounded-3 en-text"
                                                                                    style="background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%); color: white;">
                                                                                Delete
                                                                            </button>
                                                                            <button type="submit"
                                                                                    class="btn btn-lg w-100 border-0 rounded-3 ar-text"
                                                                                    style="background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%); color: white; display:none">
                                                                                حذف
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    <span class="en-text">No departments found.</span>
                                    <span class="ar-text" style="display:none">لا توجد أقسام.</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="gridView" class="grid-view" style="display:none">
            <div class="row g-4" id="departmentCardContainer">
                @if (departments.Any())
                {
                    foreach (var department in departments)
                    {
                        var statusClass = StatusBadgeClass(department.Status);
                        var statusText = department.Status.ToString();
                        var key = $"{department.Name} {department.DepartmentSpeciality} {department.Location}".ToLowerInvariant();

                        <div class="col-12 col-md-6 col-lg-4 col-xl-3" data-status="@department.Status.ToString().ToLowerInvariant()" data-keyword="@key">
                            <div class="card department-card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-lift transition-all"
                                 style="transition: all 0.3s ease; min-height: 280px; background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);">

                                <div class="card-header bg-transparent border-bottom border-light pt-3 pb-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1 pe-3">
                                            <h5 class="fw-bold mb-1 text-primary" style="font-size: 1.1rem;">@department.Name</h5>
                                            <div class="d-flex align-items-center mt-2">
                                                <i class="bi bi-geo-alt text-muted me-2" style="font-size: 0.85rem;"></i>
                                                <small class="text-muted" style="font-size: 0.85rem;">@department.Location</small>
                                            </div>
                                        </div>
                                        <span class="@statusClass badge rounded-pill fw-normal px-3 py-2"
                                              style="font-size: 0.75rem; white-space: nowrap;">
                                            <span class="en-text">@statusText</span>
                                            <span class="ar-text" style="display:none">@statusText</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="card-body d-flex flex-column pt-3">
                                    <div class="mb-3 flex-grow-1">
                                        <div class="d-flex">
                                            <i class="bi bi-briefcase text-info me-2 mt-1" style="font-size: 1rem;"></i>
                                            <p class="mb-0 text-secondary" style="font-size: 0.95rem; line-height: 1.5;">
                                                @department.DepartmentSpeciality
                                            </p>
                                        </div>
                                    </div>

                                    <div class="mt-auto pt-2">
                                        <div class="d-flex justify-content-between">
                                            <a asp-action="Details" asp-route-id="@department.Id"
                                               class="btn btn-outline-primary btn-sm rounded-pill px-3 d-flex align-items-center"
                                               style="border-width: 1.5px; font-size: 0.85rem;">
                                                <i class="bi bi-eye me-1"></i>
                                                <span class="en-text">Details</span>
                                                <span class="ar-text" style="display:none">التفاصيل</span>
                                            </a>

                                            @if (isAuthenticated && (ViewBag.CanModify == true || User.IsInRole("Admin")))
                                            {
                                                <a asp-action="Edit" asp-route-id="@department.Id"
                                                   class="btn btn-primary btn-sm rounded-pill px-3 d-flex align-items-center"
                                                   style="background: linear-gradient(135deg, #4361ee 0%, #3a56d4 100%); border: none; font-size: 0.85rem;">
                                                    <i class="bi bi-gear me-1"></i>
                                                    <span class="en-text">Manage</span>
                                                    <span class="ar-text" style="display:none">إدارة</span>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                                    <div class="progress" style="height: 3px;">
                                        <div class="progress-bar bg-info" style="width: 100%;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-5"
                             style="background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);">
                            <div class="card-body">
                                <div class="mb-4">
                                    <i class="bi bi-building text-muted" style="font-size: 4rem; opacity: 0.5;"></i>
                                </div>
                                <h5 class="text-muted mb-3 fw-normal">
                                    <span class="en-text">No departments to display</span>
                                    <span class="ar-text" style="display:none">لا توجد أقسام للعرض</span>
                                </h5>
                                <p class="text-muted mb-4" style="font-size: 0.95rem;">
                                    <span class="en-text">Add new departments to see them listed here</span>
                                    <span class="ar-text" style="display:none">أضف أقسامًا جديدة لتراها مدرجة هنا</span>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="pagination-toolbar mt-4" id="departmentsPaginationToolbar">
            <div class="page-size">
                <label for="departmentsPageSize" class="form-label mb-0">
                    <span class="en-text">Show</span>
                    <span class="ar-text" style="display:none">عرض</span>
                </label>
                <select class="form-select form-select-sm" id="departmentsPageSize" style="width: 70px; border-color: #dee2e6;">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                </select>
                <span class="text-muted small">
                    <span class="en-text">per page</span>
                    <span class="ar-text" style="display:none">لكل صفحة</span>
                </span>
            </div>
            <div class="pagination-wrapper" id="departmentsPagination"></div>
        </div>

        <div class="alert alert-info mt-3 d-none" id="departmentsEmptyState">
            <span class="en-text">No departments match your current filters.</span>
            <span class="ar-text" style="display:none">لا توجد أقسام تطابق عوامل التصفية الحالية.</span>
        </div>

        <div class="text-center mt-4">
            <p class="mb-0" style="color: var(--text-light);">
                <span class="en-text" id="departmentsCountLabelEn" data-total="@totalDepartments">Showing @totalDepartments department(s)</span>
                <span class="ar-text" style="display:none" id="departmentsCountLabelAr" data-total="@totalDepartments">إظهار @totalDepartments قسم</span>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/departments.js" asp-append-version="true"></script>
}

