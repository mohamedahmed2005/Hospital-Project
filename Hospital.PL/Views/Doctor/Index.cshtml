@model IEnumerable<Hospital.BBL.DTOs.DoctorDTOs.GetAllDoctorsDto>

@{
	Layout = "_LandingLayout";
	ViewData["Title"] = "Doctors";
	var doctors = Model?.ToList() ?? new List<Hospital.BBL.DTOs.DoctorDTOs.GetAllDoctorsDto>();
	var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}

@section PageStyles {
	<link rel="stylesheet" href="~/css/doctors.css" asp-append-version="true" />
}


@if (TempData["Edited"] != null)
{
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const toastEl = document.getElementById('Edited');
			if (toastEl) {

				const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
				toast.show();
			}
		});
	</script>
}

@if (TempData["Created"] != null)
{
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const toastEl = document.getElementById('Created');
			if (toastEl) {

				const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
				toast.show();
			}
		});
	</script>
}
@if (TempData["Deleted"] != null)
{
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const toastEl = document.getElementById('Deleted');
			if (toastEl) {

				const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
				toast.show();
			}
		});
	</script>
}

<div class="toast-container position-fixed top-0 p-3">
	<div id="Created" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="toast-header bg-primary">

			<strong class="me-auto text-white en-text">Saved</strong>
			<strong class="me-auto text-white ar-text">تم الحفظ</strong>

			<small class="en-text">1 mins ago</small>
			<small class="ar-text">قبل دقيقة واحدة</small>

			<button type="button" class="btn-close en-text" data-bs-dismiss="toast" aria-label="Close"></button>
			<button type="button" class="btn-close ar-text" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>

		<div class="toast-body text-success en-text">
			Doctor is Added successfully
		</div>
		<div class="toast-body text-success ar-text">
			تم إضافة الطبيب بنجاح
		</div>
	</div>
</div>

<div class="toast-container position-fixed top-0 p-3">
	<div id="Edited" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="toast-header bg-primary">

			<strong class="me-auto text-white en-text">Saved</strong>
			<strong class="me-auto text-white ar-text">تم الحفظ</strong>

			<small class="en-text">1 mins ago</small>
			<small class="ar-text">قبل دقيقة واحدة</small>

			<button type="button" class="btn-close en-text" data-bs-dismiss="toast" aria-label="Close"></button>
			<button type="button" class="btn-close ar-text" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>

		<div class="toast-body text-success en-text">
			update is done successfully
		</div>
		<div class="toast-body text-success ar-text">
			تم تحديث البيانات بنجاح
		</div>
	</div>
</div>

<div class="toast-container position-fixed top-0 p-3">
	<div id="Deleted" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="toast-header bg-primary">

			<strong class="me-auto text-white en-text">Done</strong>
			<strong class="me-auto text-white ar-text">تم الانتهاء</strong>

			<small class="en-text">1 mins ago</small>
			<small class="ar-text">قبل دقيقة واحدة</small>

			<button type="button" class="btn-close en-text" data-bs-dismiss="toast" aria-label="Close"></button>
			<button type="button" class="btn-close ar-text" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>

		<div class="toast-body text-success en-text">
			Doctor is Deleted successfully
		</div>
		<div class="toast-body text-success ar-text">
			تم حذف الطبيب بنجاح
		</div>
	</div>
</div>


<section class="page-header">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-md-6">
				<h1 class="display-5 fw-bold mb-3">
					<span class="en-text">Doctors Management</span>
					<span class="ar-text" style="display:none">إدارة الأطباء</span>
				</h1>
				<p class="lead mb-0">
					<span class="en-text">Manage your medical team and their information</span>
					<span class="ar-text" style="display:none">إدارة فريقك الطبي ومعلوماتهم</span>
				</p>
			</div>
			<div class="col-md-6 text-md-end">
				@if (isAuthenticated && User.IsInRole("Admin"))
				{
					<a class="btn btn-primary-custom" asp-action="Create">
						<i class="bi bi-plus-circle me-2"></i>
						<span class="en-text">Add New Doctor</span>
						<span class="ar-text" style="display:none">إضافة طبيب جديد</span>
					</a>
				}
			</div>
		</div>
	</div>
</section>

<section class="py-4">
	<div class="container">
		@if (TempData["GeneratedCredentials"] is string credentialMessage)
		{
			<div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
				@credentialMessage
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		}
		<div class="row mb-4">
			<div class="col-md-8">
				<div class="input-group">
					<input type="text" class="form-control" id="doctorSearchInput"
						   placeholder="Search doctors by name, specialty, or department..."
						   data-ar-placeholder="ابحث عن الأطباء بالاسم أو التخصص أو القسم..." />
				</div>
			</div>
			<div class="col-md-4">
				<select class="form-select" id="departmentFilter">
					<option value="" data-en="All Departments" data-ar="جميع الأقسام">All Departments</option>
					@foreach (var department in doctors.Select(d => d.Department).Distinct())
					{
						<option value="@department" data-en="@department" data-ar="@department">@department</option>
					}
				</select>
			</div>
		</div>

		<div class="table-responsive">
			<table class="table table-custom table-hover">
				<thead>
					<tr>
						<th>
							<span class="en-text">Photo</span>
							<span class="ar-text" style="display:none">الصورة</span>
						</th>
						<th>
							<span class="en-text">Name</span>
							<span class="ar-text" style="display:none">الاسم</span>
						</th>
						<th>
							<span class="en-text">Specialty</span>
							<span class="ar-text" style="display:none">التخصص</span>
						</th>
						<th>
							<span class="en-text">Department</span>
							<span class="ar-text" style="display:none">القسم</span>
						</th>
						<th>
							<span class="en-text">Email</span>
							<span class="ar-text" style="display:none">البريد الإلكتروني</span>
						</th>
						<th>
							<span class="en-text">Phone</span>
							<span class="ar-text" style="display:none">الهاتف</span>
						</th>
						<th>
							<span class="en-text">Status</span>
							<span class="ar-text" style="display:none">الحالة</span>
						</th>
						<th>
							<span class="en-text">Actions</span>
							<span class="ar-text" style="display:none">الإجراءات</span>
						</th>
					</tr>
				</thead>
				<tbody id="doctorsTableBody">
					@if (doctors.Any())
					{
						foreach (var doctor in doctors)
						{
							var avatar = string.IsNullOrWhiteSpace(doctor.Image)
							? "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=100&q=80"
							: Url.Content($"~/Files/Images/{doctor.Image}");
							var statusClass = doctor.Status switch
							{
								Hospital.DAL.Models.DoctorModule.DoctorStatus.Active => "badge bg-success",
								Hospital.DAL.Models.DoctorModule.DoctorStatus.OnLeave => "badge bg-warning",
								_ => "badge bg-secondary text-white"
							};
							<tr data-department="@doctor.Department" data-name="@doctor.Name.ToLower()" data-specialty="@doctor.Specialization.ToLower()">
								<td>
									<img src="@avatar" alt="@doctor.Name" class="doctor-image" />
								</td>
								<td>@doctor.Name</td>
								<td>@doctor.Specialization</td>
								<td>@doctor.Department</td>
								<td>@doctor.Email</td>
								<td>@doctor.PhoneNumber</td>
								<td>
									<span class="@statusClass">
										<span class="en-text">@doctor.Status</span>
										<span class="ar-text" style="display:none">@doctor.Status</span>
									</span>
								</td>
								<td>
									<div class="action-buttons">
										<a class="btn btn-sm btn-outline-custom btn-sm-custom" asp-action="Details" asp-route-id="@doctor.Id">
											<i class="bi bi-eye"></i>
										</a>
										@if (isAuthenticated && User.IsInRole("Admin"))
										{
											<a class="btn btn-sm btn-outline-custom btn-sm-custom" asp-action="Edit" asp-route-id="@doctor.Id">
												<i class="bi bi-pencil"></i>
											</a>
											<button type="submit" class="btn btn-sm btn-outline-custom btn-sm-custom" data-bs-toggle="modal" data-bs-target="#@doctor.Id">

												<i class="bi bi-trash"></i>
											</button>


											<div class="modal fade" id="@doctor.Id" tabindex="-1" aria-labelledby="Doc_delete" aria-hidden="true">
												<form asp-action="Delete"
													  asp-route-id="@doctor.Id"
													  method="post"
													  class="d-inline ">
													<div class="modal-dialog">
														<div class="modal-content">
															<div class="modal-header">

																<h1 class="modal-title en-text text-primary fs-5" id="Doc_delete">Confirmation Required</h1>
																<h1 class="modal-title ar-text text-primary fs-5" id="Doc_delete">تأكيد مطلوب</h1>

																<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
															</div>

															<div class="modal-body en-text text-secondary">
																Do you want to delete the Doctor
															</div>
															<div class="modal-body ar-text text-secondary">
																هل تريد حذف الطبيب
															</div>

															<div class="modal-footer">

																<button type="button" class="btn en-text btn-secondary" data-bs-dismiss="modal">Close</button>
																<button type="button" class="btn ar-text btn-secondary" data-bs-dismiss="modal">إغلاق</button>

																<button type="submit" class="btn btn-primary en-text">Confirm</button>
																<button type="submit" class="btn btn-primary ar-text">تأكيد</button>
															</div>
														</div>

													</div>
												</form>
											</div>
										}
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="8" class="text-center py-4">
								<span class="en-text">No doctors available.</span>
								<span class="ar-text" style="display:none">لا يوجد أطباء حالياً.</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<div class="pagination-toolbar mt-3" id="doctorsPaginationToolbar">
			<div class="page-size">
				<label for="doctorsPageSize" class="form-label mb-0">
					<span class="en-text">Show</span>
					<span class="ar-text" style="display:none">عرض</span>
				</label>
				<select class="form-select form-select-sm w-auto" id="doctorsPageSize">
					<option value="5">5</option>
					<option value="10" selected>10</option>
					<option value="15">15</option>
					<option value="20">20</option>
				</select>
				<span class="text-muted small">
					<span class="en-text">per page</span>
					<span class="ar-text" style="display:none">لكل صفحة</span>
				</span>
			</div>
			<div class="pagination-wrapper" id="doctorsPagination"></div>
		</div>

		<div class="alert alert-info mt-3 d-none" id="doctorsEmptyState">
			<span class="en-text">No doctors match your current filters.</span>
			<span class="ar-text" style="display:none">لا يوجد أطباء يطابقون عوامل التصفية الحالية.</span>
		</div>

		<div class="text-center mt-4">
			<p class="mb-0" style="color: var(--text-light);">
				<span class="en-text" id="doctorsCountLabelEn" data-total="@doctors.Count">Showing @doctors.Count doctor(s)</span>
				<span class="ar-text" style="display:none" id="doctorsCountLabelAr" data-total="@doctors.Count">إظهار @doctors.Count طبيب</span>
			</p>
		</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/doctors.js" asp-append-version="true"></script>
}

