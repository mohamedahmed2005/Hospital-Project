@model Hospital.PL.ViewModels.AccountViewModels.ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change Password";
}

<section class="auth-container">
    <div class="auth-card fade-in">
        <div class="auth-header">
            <div class="auth-logo">
                <div class="auth-logo-icon float-animation">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div>
                    <h1 class="auth-logo-text">
                        <span class="en-text">NovaHealth</span>
                        <span class="ar-text" style="display:none">نوفا هيلث</span>
                    </h1>
                </div>
            </div>
            <h2 class="auth-title">
                <span class="en-text">Change Password</span>
                <span class="ar-text" style="display:none">تغيير كلمة المرور</span>
            </h2>
            <p class="auth-subtitle">
                <span class="en-text">Update your account password</span>
                <span class="ar-text" style="display:none">قم بتحديث كلمة المرور لحسابك</span>
            </p>
        </div>

        @if (TempData["ChangePasswordSuccess"] is string successMessage)
        {
            <div class="alert alert-success mb-3" role="alert">
                @successMessage
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">
                    <span class="en-text">Current Password</span>
                    <span class="ar-text" style="display:none">كلمة المرور الحالية</span>
                </label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">
                    <span class="en-text">New Password</span>
                    <span class="ar-text" style="display:none">كلمة المرور الجديدة</span>
                </label>
                <div class="input-group">
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label">
                    <span class="en-text">Confirm New Password</span>
                    <span class="ar-text" style="display:none">تأكيد كلمة المرور الجديدة</span>
                </label>
                <div class="input-group">
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 mb-3">
                <span class="en-text">Save New Password</span>
                <span class="ar-text" style="display:none">حفظ كلمة المرور الجديدة</span>
            </button>
        </form>

        <div class="auth-footer">
            <p>
                <span class="en-text">Back to your dashboard?</span>
                <span class="ar-text" style="display:none">العودة إلى لوحة التحكم؟</span>
                <a asp-controller="Home" asp-action="Index">
                    <span class="en-text">Go Home</span>
                    <span class="ar-text" style="display:none">اذهب للرئيسية</span>
                </a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


