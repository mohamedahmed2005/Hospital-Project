@model Hospital.PL.ViewModels.AccountViewModels.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<section class="auth-container">
    <div class="auth-card fade-in">
        <div class="auth-header">
            <div class="auth-logo">
                <div class="auth-logo-icon float-animation">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div>
                    <h1 class="auth-logo-text">
                        <span class="en-text">NovaHealth</span>
                        <span class="ar-text" style="display:none">نوفا هيلث</span>
                    </h1>
                </div>
            </div>
            <h2 class="auth-title">
                <span class="en-text">Reset Password</span>
                <span class="ar-text" style="display:none">إعادة تعيين كلمة المرور</span>
            </h2>
            <p class="auth-subtitle">
                <span class="en-text">Choose a new password for your account</span>
                <span class="ar-text" style="display:none">اختر كلمة مرور جديدة لحسابك</span>
            </p>
        </div>

        <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    <span class="en-text">New Password</span>
                    <span class="ar-text" style="display:none">كلمة المرور الجديدة</span>
                </label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">
                    <span class="en-text">Confirm New Password</span>
                    <span class="ar-text" style="display:none">تأكيد كلمة المرور الجديدة</span>
                </label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 mb-3">
                <span class="en-text">Reset Password</span>
                <span class="ar-text" style="display:none">إعادة تعيين كلمة المرور</span>
            </button>
        </form>

        <div class="auth-footer">
            <p>
                <span class="en-text">Remembered your password?</span>
                <span class="ar-text" style="display:none">تذكرت كلمة المرور؟</span>
                <a asp-action="Login">
                    <span class="en-text">Back to sign in</span>
                    <span class="ar-text" style="display:none">العودة لتسجيل الدخول</span>
                </a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


