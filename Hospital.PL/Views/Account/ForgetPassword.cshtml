@model Hospital.PL.ViewModels.AccountViewModels.ForgetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-container">
    <div class="auth-card fade-in">
        <div class="auth-header">
            <div class="auth-logo">
                <div class="auth-logo-icon float-animation">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div>
                    <h1 class="auth-logo-text">
                        <span class="en-text">NovaHealth</span>
                        <span class="ar-text" style="display:none">نوفا هيلث</span>
                    </h1>
                </div>
            </div>
            <h2 class="auth-title">
                <span class="en-text">Forgot Password</span>
                <span class="ar-text" style="display:none">نسيت كلمة المرور</span>
            </h2>
            <p class="auth-subtitle">
                <span class="en-text">Enter your email to reset your password</span>
                <span class="ar-text" style="display:none">أدخل بريدك الإلكتروني لإعادة تعيين كلمة المرور</span>
            </p>
        </div>

        <form asp-action="SendResetPasswordLink" method="post" class="needs-validation" novalidate>
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <p>
                    <span class="en-text">We'll send a password reset link to your email address.</span>
                    <span class="ar-text" style="display:none">سنرسل رابط إعادة تعيين كلمة المرور إلى عنوان بريدك الإلكتروني.</span>
                </p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    <span class="en-text">Email Address</span>
                    <span class="ar-text" style="display:none">البريد الإلكتروني</span>
                </label>
                <input asp-for="Email" class="form-control" placeholder="you@novahealth.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom mb-3 w-100">
                <span class="en-text">Send Reset Link</span>
                <span class="ar-text" style="display:none">إرسال رابط إعادة التعيين</span>
            </button>
        </form>

        <div class="auth-footer">
            <p>
                <span class="en-text">Remember your password?</span>
                <span class="ar-text" style="display:none">تذكرت كلمة المرور؟</span>
                <a asp-action="Login">
                    <span class="en-text">Back to sign in</span>
                    <span class="ar-text" style="display:none">العودة لتسجيل الدخول</span>
                </a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

