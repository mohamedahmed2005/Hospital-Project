@model IEnumerable<Hospital.BBL.DTOs.PatientDTOs.GetAllPatientsDto>
@using Hospital.DAL.Models.PatientModule
@{
    ViewData["Title"] = "Patients";
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;

    string GetStatusBadgeClass(PatientStatus status) => status switch
    {
        PatientStatus.Active => "badge-active",
        PatientStatus.InActive => "badge-inactive",
        PatientStatus.New => "badge-new",
        _ => "badge-active"
    };

    string FormatStatus(PatientStatus status) => status switch
    {
        PatientStatus.Active => "Active",
        PatientStatus.InActive => "Inactive",
        PatientStatus.New => "New",
        _ => status.ToString()
    };

    string FormatBloodType(BloodType type) => type switch
    {
        BloodType.A_Pos => "A+",
        BloodType.A_Neg => "A-",
        BloodType.B_Pos => "B+",
        BloodType.B_Neg => "B-",
        BloodType.AB_Pos => "AB+",
        BloodType.AB_Neg => "AB-",
        BloodType.O_Pos => "O+",
        BloodType.O_Neg => "O-",
        _ => type.ToString()
    };

    string ResolvePhoto(string? imageUrl, int seed) =>
        !string.IsNullOrWhiteSpace(imageUrl)
            ? $"~/Files/Images/{imageUrl}"
            : $"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=100&q=80&sig={seed}";

    string BuildSearchKey(Hospital.BBL.DTOs.PatientDTOs.GetAllPatientsDto patient) =>
        $"{patient.Name} {patient.Email} {patient.PhoneNumber ?? string.Empty}".ToLowerInvariant();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/patients.css" asp-append-version="true" />
}

@if (TempData["Edited"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Edited');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}
@if (TempData["Created"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Created');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}
@if (TempData["Deleted"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toastEl = document.getElementById('Deleted');
            if (toastEl) {

                const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                toast.show();
            }
        });
    </script>
}
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="Created" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #20c997 0%, #1aa179 100%);">
        <div class="toast-header border-0" style="background: rgba(255, 255, 255, 0.1);">
            <i class="bi bi-person-plus text-white me-2"></i>
            <strong class="me-auto text-white en-text">Saved</strong>
            <strong class="me-auto text-white ar-text" style="display:none">تم الحفظ</strong>
            <small class="text-white-50 en-text">just now</small>
            <small class="text-white-50 ar-text" style="display:none">الآن</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-white">
            <div class="en-text">Patient Created successfully</div>
            <div class="ar-text" style="display:none">تم إنشاء المريض بنجاح</div>
        </div>
    </div>

    <div id="Edited" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);">
        <div class="toast-header border-0" style="background: rgba(255, 255, 255, 0.1);">
            <i class="bi bi-person-check text-white me-2"></i>
            <strong class="me-auto text-white en-text">Saved</strong>
            <strong class="me-auto text-white ar-text" style="display:none">تم الحفظ</strong>
            <small class="text-white-50 en-text">just now</small>
            <small class="text-white-50 ar-text" style="display:none">الآن</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-white">
            <div class="en-text">Patient updated successfully</div>
            <div class="ar-text" style="display:none">تم تحديث بيانات المريض بنجاح</div>
        </div>
    </div>

    <div id="Deleted" class="toast border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%);">
        <div class="toast-header border-0" style="background: rgba(255, 255, 255, 0.1);">
            <i class="bi bi-person-x text-white me-2"></i>
            <strong class="me-auto text-white en-text">Done</strong>
            <strong class="me-auto text-white ar-text" style="display:none">تم الانتهاء</strong>
            <small class="text-white-50 en-text">just now</small>
            <small class="text-white-50 ar-text" style="display:none">الآن</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body text-white">
            <div class="en-text">Patient Deleted successfully</div>
            <div class="ar-text" style="display:none">تم حذف المريض بنجاح</div>
        </div>
    </div>
</div>



<section class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-5 fw-bold mb-3">
                    <span class="en-text">Patients Management</span>
                    <span class="ar-text" style="display:none">إدارة المرضى</span>
                </h1>
                <p class="lead mb-0">
                    <span class="en-text">Manage patient records and medical information</span>
                    <span class="ar-text" style="display:none">إدارة سجلات المرضى والمعلومات الطبية</span>
                </p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                @if (isAuthenticated && User.IsInRole("Patient") && ViewBag.CurrentUserPatientId != null)
                {
                    <a class="btn btn-primary-custom me-2" asp-action="Details" asp-route-id="@ViewBag.CurrentUserPatientId">
                        <i class="bi bi-person me-2"></i>
                        <span class="en-text">My Profile</span>
                        <span class="ar-text" style="display:none">ملفي الشخصي</span>
                    </a>
                }
                @if (isAuthenticated && (ViewBag.CanModify == true || User.IsInRole("Admin")))
                {
                    <a class="btn btn-primary-custom" asp-action="Create">
                        <i class="bi bi-plus-circle me-2"></i>
                        <span class="en-text">Add New Patient</span>
                        <span class="ar-text" style="display:none">إضافة مريض جديد</span>
                    </a>
                }
                @if (isAuthenticated && User.IsInRole("Patient") && ViewBag.HasProfile == false)
                {
                    <a class="btn btn-primary-custom" asp-action="Create">
                        <i class="bi bi-person-plus me-2"></i>
                        <span class="en-text">Create Profile</span>
                        <span class="ar-text" style="display:none">إنشاء ملف شخصي</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        @if (TempData["GeneratedCredentials"] is string credentialMessage)
        {
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                @credentialMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="row mb-4 g-3">
            <div class="col-md-8">
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           id="searchInput"
                           placeholder="Search patients by name, email, or phone..."
                           data-ar-placeholder="ابحث عن المرضى بالاسم أو البريد الإلكتروني أو الهاتف..." />

                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select" id="statusFilter">
                    <option value="" data-en="All Statuses" data-ar="جميع الحالات">All Statuses</option>
                    <option value="active" data-en="Active" data-ar="نشط">Active</option>
                    <option value="inactive" data-en="Inactive" data-ar="غير نشط">Inactive</option>
                    <option value="new" data-en="New" data-ar="جديد">New</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-custom table-hover">
                <thead>
                    <tr>
                        <th><span class="en-text">Photo</span><span class="ar-text" style="display:none">الصورة</span></th>
                        <th><span class="en-text">Name</span><span class="ar-text" style="display:none">الاسم</span></th>
                        <th><span class="en-text">Email</span><span class="ar-text" style="display:none">البريد الإلكتروني</span></th>
                        <th><span class="en-text">Phone</span><span class="ar-text" style="display:none">الهاتف</span></th>
                        <th><span class="en-text">Age</span><span class="ar-text" style="display:none">العمر</span></th>
                        <th><span class="en-text">Gender</span><span class="ar-text" style="display:none">الجنس</span></th>
                        <th><span class="en-text">Blood Type</span><span class="ar-text" style="display:none">فصيلة الدم</span></th>
                        <th><span class="en-text">Status</span><span class="ar-text" style="display:none">الحالة</span></th>
                        <th><span class="en-text">Actions</span><span class="ar-text" style="display:none">الإجراءات</span></th>
                    </tr>
                </thead>
                <tbody id="patientsTableBody">
                    @if (Model is null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="bi bi-people display-4 d-block mb-3"></i>
                                    <p class="mb-0">
                                        <span class="en-text">No patients found. Start by adding a new patient.</span>
                                        <span class="ar-text" style="display:none">لا يوجد مرضى. ابدأ بإضافة مريض جديد.</span>
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var index = 0;
                        foreach (var patient in Model)
                        {
                            index++;
                            var searchKey = BuildSearchKey(patient);
                            var statusValue = patient.Status.ToString().ToLowerInvariant();
                            <tr data-keywords="@searchKey" data-status="@statusValue">
                                <td>
                                    <img src="@Url.Content(ResolvePhoto(patient.Image, index))"
                                         alt="@patient.Name"
                                         class="patient-image" />
                                </td>
                                <td>@patient.Name</td>
                                <td>@patient.Email</td>
                                <td>@patient.PhoneNumber</td>
                                <td>@patient.Age</td>
                                <td>
                                    <span class="en-text">@patient.Gender</span>
                                    <span class="ar-text" style="display:none">@patient.Gender</span>
                                </td>
                                <td>@FormatBloodType(patient.BloodType)</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(patient.Status)">
                                        <span class="en-text">@FormatStatus(patient.Status)</span>
                                        <span class="ar-text" style="display:none">@FormatStatus(patient.Status)</span>
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a class="btn btn-sm btn-outline-custom btn-sm-custom"
                                           asp-action="Details"
                                           asp-route-id="@patient.Id">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @{
                                            bool canEdit = false;
                                            bool isOwnProfile = false;
                                            if (isAuthenticated)
                                            {
                                                if (User.IsInRole("Admin"))
                                                {
                                                    canEdit = true;
                                                }
                                                else if (User.IsInRole("Patient") && ViewBag.CurrentUserPatientId != null && patient.Id == (int)ViewBag.CurrentUserPatientId)
                                                {
                                                    canEdit = true;
                                                    isOwnProfile = true;
                                                }
                                            }
                                        }
                                        @if (canEdit)
                                        {
                                            <a class="btn btn-sm btn-outline-custom btn-sm-custom"
                                               asp-action="Edit"
                                               asp-route-id="@patient.Id">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (isAuthenticated && User.IsInRole("Admin"))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-custom btn-sm-custom" data-bs-toggle="modal" data-bs-target="#@patient.Id">

                                                <i class="bi bi-trash"></i>
                                            </button>

                                            <div class="modal fade" id="@patient.Id" tabindex="-1" aria-labelledby="Patient_delete" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden"
                                                         style="background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%); border: 1px solid rgba(32, 201, 151, 0.1);">

                                                        <div class="modal-header border-0 pb-0"
                                                             style="background: linear-gradient(135deg, #20c997 0%, #1aa179 100%);">
                                                            <div class="modal-title w-100 text-center">
                                                                <i class="bi bi-person-x text-white fs-2 mb-2 d-block"></i>
                                                                <h5 class="text-white en-text mb-0 fw-bold">Patient Removal</h5>
                                                                <h5 class="text-white ar-text mb-0 fw-bold" style="display:none">إزالة المريض</h5>
                                                            </div>
                                                            <button type="button" class="btn-close btn-close-white position-absolute end-0 me-3"
                                                                    data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>

                                                        <div class="modal-body pt-4 pb-3 text-center">
                                                            <p class="text-black en-text fs-5 mb-2">
                                                                Are you sure you want to remove this patient?
                                                            </p>
                                                            <p class="text-black ar-text fs-5 mb-2" style="display:none">
                                                                هل أنت متأكد من رغبتك في إزالة هذا المريض؟
                                                            </p>
                                                            <p class="  en-text small mb-0">
                                                                Patient records and appointments will be permanently deleted.
                                                            </p>
                                                            <p class="  ar-text small mb-0" style="display:none">
                                                                سيتم حذف سجلات المريض ومواعيده بشكل دائم.
                                                            </p>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <form asp-action="Delete" asp-route-id="@patient.Id" method="post" class="w-100">
                                                                @Html.AntiForgeryToken()
                                                                <div class="row g-2">
                                                                    <div class="col-6">
                                                                        <button type="button"
                                                                                class="btn btn-lg w-100 border-0 rounded-3 en-text"
                                                                                style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); color: white;"
                                                                                data-bs-dismiss="modal">
                                                                            Keep Patient
                                                                        </button>
                                                                        <button type="button"
                                                                                class="btn btn-lg w-100 border-0 rounded-3 ar-text"
                                                                                style="background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); color: white; display:none"
                                                                                data-bs-dismiss="modal">
                                                                            الاحتفاظ بالمريض
                                                                        </button>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <button type="submit"
                                                                                class="btn btn-lg w-100 border-0 rounded-3 en-text"
                                                                                style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%); color: white;">
                                                                            Remove Patient
                                                                        </button>
                                                                        <button type="submit"
                                                                                class="btn btn-lg w-100 border-0 rounded-3 ar-text"
                                                                                style="background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%); color: white; display:none">
                                                                            إزالة المريض
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-toolbar mt-3" id="patientsPaginationToolbar">
            <div class="page-size">
                <label for="patientsPageSize" class="form-label mb-0">
                    <span class="en-text">Show</span>
                    <span class="ar-text" style="display:none">عرض</span>
                </label>
                <select class="form-select form-select-sm" id="patientsPageSize" style="width: 70px; border-color: #dee2e6;">
                    <option value="5" selected>5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                </select>
                <span class="text-muted small">
                    <span class="en-text">per page</span>
                    <span class="ar-text" style="display:none">لكل صفحة</span>
                </span>
            </div>
            <div class="pagination-wrapper" id="patientsPagination"></div>
        </div>

        <div class="alert alert-info mt-3 d-none" id="patientsEmptyState">
            <span class="en-text">No patients match your current filters.</span>
            <span class="ar-text" style="display:none">لا يوجد مرضى يطابقون عوامل التصفية الحالية.</span>
        </div>

        <div class="text-center mt-4">
            <p class="mb-0" style="color: var(--text-light);">
                <span class="en-text" id="patientsCountLabelEn" data-total="@((Model?.Count() ?? 0))">Showing @((Model?.Count() ?? 0)) patient(s)</span>
                <span class="ar-text" style="display:none" id="patientsCountLabelAr" data-total="@((Model?.Count() ?? 0))">إظهار @((Model?.Count() ?? 0)) مريض</span>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/patients.js" asp-append-version="true"></script>
}

