@model Hospital.PL.ViewModels.PatientViewModel
@using Hospital.DAL.Models.PatientModule
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Add Patient";

    var genderOptions = Enum.GetValues<Gender>()
        .Select(g => new SelectListItem { Value = g.ToString(), Text = g.ToString() })
        .ToList();

    var bloodTypeOptions = Enum.GetValues<BloodType>()
        .Select(bt => new SelectListItem
        {
            Value = bt.ToString(),
            Text = bt switch
            {
                BloodType.A_Pos => "A+",
                BloodType.A_Neg => "A-",
                BloodType.B_Pos => "B+",
                BloodType.B_Neg => "B-",
                BloodType.AB_Pos => "AB+",
                BloodType.AB_Neg => "AB-",
                BloodType.O_Pos => "O+",
                BloodType.O_Neg => "O-",
                _ => bt.ToString()
            }
        })
        .ToList();
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/patients.css" asp-append-version="true" />
}

<section class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold mb-3">
                    <span class="en-text">Add New Patient</span>
                    <span class="ar-text" style="display:none">إضافة مريض جديد</span>
                </h1>
                <p class="lead mb-0">
                    <span class="en-text">Capture personal details and medical history in one place.</span>
                    <span class="ar-text" style="display:none">سجل التفاصيل الشخصية والتاريخ الطبي في مكان واحد.</span>
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-action="Index" class="btn btn-outline-custom">
                    <i class="bi bi-arrow-left me-2"></i>
                    <span class="en-text">Back to Patients</span>
                    <span class="ar-text" style="display:none">العودة للمرضى</span>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <ul class="nav nav-tabs nav-tabs-custom" id="patientTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal-info" type="button" role="tab">
                                <span class="en-text">Personal Info</span>
                                <span class="ar-text" style="display:none">المعلومات الشخصية</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="medical-tab" data-bs-toggle="tab" data-bs-target="#medical-info" type="button" role="tab">
                                <span class="en-text">Medical Data</span>
                                <span class="ar-text" style="display:none">البيانات الطبية</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content pt-4">
                        <div class="tab-pane fade show active" id="personal-info" role="tabpanel" aria-labelledby="personal-tab">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label">
                                        <span class="en-text">First Name</span>
                                        <span class="ar-text" style="display:none">الاسم الأول</span>
                                    </label>
                                    <input asp-for="FirstName" class="form-control" required />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label">
                                        <span class="en-text">Last Name</span>
                                        <span class="ar-text" style="display:none">الاسم الأخير</span>
                                    </label>
                                    <input asp-for="LastName" class="form-control" required />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label">
                                        <span class="en-text">Email</span>
                                        <span class="ar-text" style="display:none">البريد الإلكتروني</span>
                                    </label>
                                    <input asp-for="Email" class="form-control" required />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="col-md-6">
                                        <label class="form-label">
                                            <span class="en-text">Temporary Password (optional)</span>
                                            <span class="ar-text" style="display:none">كلمة مرور مؤقتة (اختياري)</span>
                                        </label>
                                        <input asp-for="AccountPassword" type="password" class="form-control" placeholder="Patient@123" data-ar-placeholder="Patient@123" />
                                        <div class="form-text">
                                            <span class="en-text">Leave empty to use the default password (Patient@123). Share it with the patient so they can sign in and reset it.</span>
                                            <span class="ar-text" style="display:none">اتركه فارغاً لاستخدام كلمة المرور الافتراضية (Patient@123). شاركها مع المريض ليتمكن من تسجيل الدخول وتغييرها.</span>
                                        </div>
                                        <span asp-validation-for="AccountPassword" class="text-danger small"></span>
                                    </div>
                                }
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label">
                                        <span class="en-text">Phone</span>
                                        <span class="ar-text" style="display:none">الهاتف</span>
                                    </label>
                                    <input asp-for="PhoneNumber" class="form-control" required />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DateOfBirth" class="form-label">
                                        <span class="en-text">Date of Birth</span>
                                        <span class="ar-text" style="display:none">تاريخ الميلاد</span>
                                    </label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" required />
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Gender" class="form-label">
                                        <span class="en-text">Gender</span>
                                        <span class="ar-text" style="display:none">الجنس</span>
                                    </label>
                                    <select asp-for="Gender" class="form-select" asp-items="genderOptions">
                                        <option value="">Select Gender</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Address" class="form-label">
                                        <span class="en-text">Address</span>
                                        <span class="ar-text" style="display:none">العنوان</span>
                                    </label>
                                    <textarea asp-for="Address" rows="2" class="form-control"></textarea>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Image" class="form-label">
                                        <span class="en-text">Photo</span>
                                        <span class="ar-text" style="display:none">الصورة</span>
                                    </label>
                                    <input asp-for="Image" type="file" class="form-control" accept="image/*" />
                                    <span asp-validation-for="Image" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="medical-info" role="tabpanel" aria-labelledby="medical-tab">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="BloodType" class="form-label">
                                        <span class="en-text">Blood Type</span>
                                        <span class="ar-text" style="display:none">فصيلة الدم</span>
                                    </label>
                                    <select asp-for="BloodType" class="form-select" asp-items="bloodTypeOptions">
                                        <option value="">Select Blood Type</option>
                                    </select>
                                    <span asp-validation-for="BloodType" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Height" class="form-label">
                                        <span class="en-text">Height (cm)</span>
                                        <span class="ar-text" style="display:none">الطول (سم)</span>
                                    </label>
                                    <input asp-for="Height" type="number" step="0.1" class="form-control" required />
                                    <span asp-validation-for="Height" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Weight" class="form-label">
                                        <span class="en-text">Weight (kg)</span>
                                        <span class="ar-text" style="display:none">الوزن (كجم)</span>
                                    </label>
                                    <input asp-for="Weight" type="number" step="0.1" class="form-control" required />
                                    <span asp-validation-for="Weight" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Allergies" class="form-label">
                                        <span class="en-text">Allergies</span>
                                        <span class="ar-text" style="display:none">الحساسية</span>
                                    </label>
                                    <input asp-for="Allergies" class="form-control" placeholder="Penicillin, Nuts..." />
                                    <span asp-validation-for="Allergies" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="MedicalHistory" class="form-label">
                                        <span class="en-text">Medical History</span>
                                        <span class="ar-text" style="display:none">التاريخ الطبي</span>
                                    </label>
                                    <textarea asp-for="MedicalHistory" rows="3" class="form-control"></textarea>
                                    <span asp-validation-for="MedicalHistory" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CurrentMedications" class="form-label">
                                        <span class="en-text">Current Medications</span>
                                        <span class="ar-text" style="display:none">الأدوية الحالية</span>
                                    </label>
                                    <textarea asp-for="CurrentMedications" rows="2" class="form-control"></textarea>
                                    <span asp-validation-for="CurrentMedications" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-custom">
                            <span class="en-text">Cancel</span>
                            <span class="ar-text" style="display:none">إلغاء</span>
                        </a>
                        <button type="submit" class="btn btn-primary-custom">
                            <span class="en-text">Add Patient</span>
                            <span class="ar-text" style="display:none">إضافة مريض</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

